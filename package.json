{
  "name": "chatbox",
  "productName": "Chatbox",
  "version": "2.0.0-beta",
  "private": true,
  "description": "Send 7TV emotes that pop up on top of your friends' screens",
  "homepage": "https://github.com/MineRaphi/chatbox#readme",
  "bugs": {
    "url": "https://github.com/MineRaphi/chatbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MineRaphi/chatbox.git"
  },
  "license": "ISC",
  "author": "MineRaphi",
  "main": ".vite/build/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "45.2.3",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    }
  }
}
